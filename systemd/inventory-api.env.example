# /etc/inventory-api/inventory-api.env - environment file for the IMS systemd unit (ims.service).
#
#   sudo cp systemd/ims.env.example /etc/inventory-api/inventory-api.env  # then edit
#   sudo chown root:ims /etc/inventory-api/inventory-api.env
#   sudo chmod 640 /etc/inventory-api/inventory-api.env
#   sudo systemctl restart ims
#
# Every variable below is OPTIONAL - the application falls back to sensible
# defaults (see src/main/resources/application.properties). Uncomment and set
# what your deployment needs. Keep this file out of version control: it holds
# secrets.

# ---------------------------------------------------------------------------
# Database (use the least-privileged app role: SELECT/INSERT/UPDATE/DELETE/
# EXECUTE only - DDL belongs to the migration role below).
# ---------------------------------------------------------------------------
#IMS_DB_URL=jdbc:mysql://127.0.0.1:3306/inventory_db?useSSL=false&allowPublicKeyRetrieval=true
#IMS_DB_USERNAME=ims_app
#IMS_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# HTTP listener (defaults shown; keep 127.0.0.1 when fronted by a local
# reverse proxy, use 0.0.0.0 only if the host is otherwise protected).
# ---------------------------------------------------------------------------
#IMS_HTTP_HOST=127.0.0.1
#IMS_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Bootstrap admin password - read ONLY on the first boot with an empty users
# table. If unset, a random password is generated into
# /opt/ims/logs/bootstrap-admin.txt. Rotate immediately after first login.
# ---------------------------------------------------------------------------
#IMS_BOOTSTRAP_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Migration role (DDL-privileged) - NOT used by the running service; export
# these only when invoking the migration tool, e.g.:
#   sudo -u ims IMS_MIGRATE_USERNAME=ims_migrate IMS_MIGRATE_PASSWORD=... \
#     /usr/bin/java -cp /opt/ims/ims.jar:/opt/ims/lib/* com.ims.tools.Migrate
# ---------------------------------------------------------------------------
#IMS_MIGRATE_USERNAME=ims_migrate
#IMS_MIGRATE_PASSWORD=change-me
