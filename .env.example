# docker-compose / docker stack secrets template.
# Copy to .env next to docker-compose.yml and edit:
#   cp .env.example .env
#
# IMS_BOOTSTRAP_ADMIN_PASSWORD is the password assigned to the initial 'admin'
# user on FIRST boot only (when the users table is empty). Rotate it right
# after the first login. Never commit the real .env file.
IMS_BOOTSTRAP_ADMIN_PASSWORD=changeme
